#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
    &kp TAB &kp Q &kp W &kp F &kp P &kp FSLH                                           &kp BSLH &kp L &kp U     &kp Y   &kp P    &kp BSLH
    &kp ESC &kp A &kp R &kp S &kp T &kp B                                              &kp J    &kp N &kp E     &kp I   &kp O    &kp RALT
    &kp X   &kp Z &kp M &kp C &kp D &kp G &mo 1 &kp LSHFT              &kp SPACE &mo 2 &kp K    &kp H &kp COMMA &kp DOT &kp FSLH &kp RCTRL
                 &kp C_MUTE &kp DEL &kp V &mo 1 &kp LSHFT              &kp SPACE &mo 2 &kp SEMI &kp BSPC &kp HOME
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_DN PG_UP>;
        };
        symbol_layer {
            bindings = <
    &trans &trans &trans &trans &trans &trans                                    &trans &trans &trans &trans &trans &trans
    &trans &trans &trans &trans &trans &trans                                    &trans &trans &trans &trans &trans &trans
    &trans &trans &trans &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans &trans &trans &trans
                         &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_DN PG_UP>;
        };
        number_layer {
            bindings = <
    &trans &trans &trans &trans &trans &trans                                    &trans &trans &trans &trans &trans &trans
    &trans &trans &trans &trans &trans &trans                                    &trans &trans &trans &trans &trans &trans
    &trans &trans &trans &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans &trans &trans &trans
                         &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_DN PG_UP>;
        };
        function_layer {
// ---------------------------------------------------------------------------------------------------------------------------------
// |       |      |BT_CLR|BTSEL0|BTSEL1|BTSEL2|                                         |      |      |      |      |      |      |
// |       |      |      |BTSEL3|BTSEL4|      |                                         |      |      |      |      |      |      |
// |       |      |      |      |      |      |      |      |      |      |      |      |      |      |      |      |      |      |
//                       |      |      |      |      |      |      |      |      |      |      |      |      |
            bindings = <
    &trans &trans &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2              &trans &trans &trans &trans &trans &trans
    &trans &trans &trans     &bt BT_SEL 3 &bt BT_SEL 4 &trans                    &trans &trans &trans &trans &trans &trans
    &trans &trans &trans &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans &trans &trans &trans
                         &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_DN PG_UP>;
        };
    };
};
