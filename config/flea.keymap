#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEF 0
#define SYM 1
#define NUM 2
#define CFG 3

#include "combos.dtsi"

&mt {
    // flavor = "tap-preferred";
    // tapping_term_ms = <200>;
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        config_layer {
            if-layers = <SYM NUM>;
            then-layer = <CFG>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
//     ┌───┬───┬───┬───┐       ┌───┬───┬───┬───┐
//     │ W │ F │ P │ B │       │ J │ L │ U │ Y │
// ┌───┼───┼───┼───┼───┤       ├───┼───┼───┼───┼───┐
// │ A │ R │ S │ T │ G │       │ K │ N │ E │ I │ O │
// ├───┼───┼───┼───┼───┘       └───┼───┼───┼───┼───┤
// │ Z │ M │ C │ D │               │ H │ , │ . │ ' │
// └───┴───┴───┼───┼───┐       ┌───┼───┼───┴───┴───┘
//             │SYM│SFT│       │SPC│NUM│
//             └───┴───┘       └───┴───┘
            bindings = <
                      &kp W &kp F &kp P   &kp B       &kp J   &kp L &kp U    &kp Y
                &kp A &kp R &kp S &kp T   &kp G       &kp K   &kp N &kp E    &kp I   &kp O
                &kp Z &kp M &kp C &kp D                       &kp H &kp CMMA &kp DOT &kp SQT
                                  &mo SYM &kp LSHFT   &kp SPC &mo NUM
            >;
        };

        symbol_layer {
//     ┌───┬───┬───┬───┐       ┌───┬───┬───┬───┐
//     │ { │ ( │ / │ [ │       │ ] │ \ │ ) │ } │
// ┌───┼───┼───┼───┼───┤       ├───┼───┼───┼───┼───┐
// │ # │ * │ + │ - │ @ │       │ & │ _ │ = │ ^ │ $ │
// ├───┼───┼───┼───┼───┘       └───┼───┼───┼───┼───┤
// │ % │ ! │ ` │ : │               │ ; │ ~ │ ? │ | │
// └───┴───┴───┼───┼───┐       ┌───┼───┼───┴───┴───┘
//             │███│   │       │   │   │
//             └───┴───┘       └───┴───┘
            bindings = <
                          &kp LBRC  &kp LPAR  &kp FSLH  &kp LBKT    &kp RBKT  &kp BSLH  &kp RPAR  &kp RBRC
                &kp HASH  &kp ASTRK &kp PLUS  &kp MINUS &kp AT      &kp AMPS  &kp UNDER &kp EQUAL &kp CARET &kp DLLR
                &kp PRCNT &kp EXCL  &kp GRAVE &kp COLON                       &kp SEMI  &kp TILDE &kp QMARK &kp PIPE
                                              &trans    &trans      &trans    &trans
            >;
        };

        number_layer {
//     ┌───┬───┬───┬───┐       ┌───┬───┬───┬───┐
//     │ 4 │ 5 │ 6 │ . │       │ ↓ │ → │   │   │
// ┌───┼───┼───┼───┼───┤       ├───┼───┼───┼───┼───┐
// │ 0 │ 1 │ 2 │ 3 │ , │       │ ↑ │PST│CPY│CUT│PGU│
// ├───┼───┼───┼───┼───┘       └───┼───┼───┼───┼───┤
// │   │ 7 │ 8 │ 9 │               │ ← │HME│ENT│PGD│
// └───┴───┴───┼───┼───┐       ┌───┼───┼───┴───┴───┘
//             │   │   │       │   │███│
//             └───┴───┘       └───┴───┘
            bindings = <
                         &kp N4 &kp N5 &kp N6 &kp DOT       &kp DOWN  &kp RIGHT  &trans      &trans
                &kp N0   &kp N1 &kp N2 &kp N3 &kp CMMA      &kp UP    &kp LG(V)  &kp LG(C)   &kp LG(X) &kp PG_UP
                &trans   &kp N7 &kp N8 &kp N9                          &kp LEFT   &kp HOME    &kp RET   &kp PG_DN
                                       &trans &trans         &trans    &trans
            >;
        };
        config_layer {
          //     ┌───┬───┬───┬───┐       ┌───┬───┬───┬───┐
          //     │   │   │   │VUP│       │CLA│   │   │LCK│
          // ┌───┼───┼───┼───┼───┤       ├───┼───┼───┼───┼───┐
          // │MUT│PRV│PLY│NXT│VDN│       │CLR│BT0│BT1│BT2│BT3│
          // ├───┼───┼───┼───┼───┘       └───┼───┼───┼───┼───┤
          // │   │PWR│SLP│LCK│               │   │BLE│USB│TOG│
          // └───┴───┴───┼───┼───┐       ┌───┼───┼───┴───┴───┘
          //             │███│   │       │   │███│
          //             └───┴───┘       └───┴───┘
          bindings = <
                              &trans       &trans      &trans      &kp C_VOL_UP    &bt BT_CLR_ALL &trans       &trans       &studio_unlock
            &kp C_MUTE        &kp C_PREV   &kp C_PP    &kp C_NEXT  &kp C_VOL_DN    &bt BT_CLR     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3
            &trans            &kp C_PWR    &kp C_SLEEP &kp LC(LG(Q))                              &trans       &out OUT_BLE &out OUT_USB &out OUT_TOG
                                                       &trans      &trans          &trans         &trans
          >;
        };
    };
};
